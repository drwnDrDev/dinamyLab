APP_NAME=DinamyLAB
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# SQLite en memoria: requiere la extensión PHP pdo_sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
