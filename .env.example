# =============================================================================
# DinamyLAB — plantilla de .env
#
# Los valores activos sirven para desarrollo con Docker (cp .env.example .env).
# Para producción, cada línea marcada "PROD:" indica el valor que debe tener.
#
# Modelo actual: 2 instancias (una por laboratorio) en la misma cuenta cPanel,
# clonadas del mismo repositorio y con el mismo tag. Cada instancia tiene su
# propio .env, su base de datos, su storage/ y su cookie de sesión. Ninguna
# diferencia entre clientes vive en el código: vive aquí.
# Runbook: docs/DESPLIEGUE_INSTANCIAS.md
#
#   [INSTANCIA]  distinto en cada laboratorio; nunca copiar el de la otra
#   [COMPARTIDO] puede ser igual en las dos instancias
#
# Después de cambiar este archivo en producción: php artisan config:cache
# y php artisan instancia:verificar (debe salir con código 0).
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# [INSTANCIA] Nombre comercial del laboratorio (sale en la interfaz y en correos).
APP_NAME=Lissapp
# PROD: production
APP_ENV=local
# [INSTANCIA] php artisan key:generate, una vez por instancia. Nunca reutilizar
# la de la otra instancia ni cambiarla con datos cargados (invalida sesiones y
# todo lo cifrado).
APP_KEY=
# PROD: false (instancia:verificar falla si queda en true)
APP_DEBUG=true
# [INSTANCIA] PROD: https://<dominio-del-laboratorio>
APP_URL=http://localhost:8000
# [COMPARTIDO] Hora de Colombia. Definirla ANTES del primer dato real: si se
# cambia después, lo ya guardado queda desfasado 5 horas.
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Instancia (aislamiento entre laboratorios) ------------------------------
# [INSTANCIA] Nombre corto del laboratorio, sin espacios (ej. biotek). Debe
# coincidir con la carpeta ~/apps/<instancia> y con SESSION_COOKIE.
# Vacío = desarrollo y tests (la guarda de dominio no actúa).
APP_INSTANCE=
# [INSTANCIA] Dominios que atiende esta instancia, separados por comas. Debe
# incluir el host de APP_URL. Una petición a otro dominio responde 503.
APP_HOSTS=

# --- Datos del laboratorio (los usa ClienteSeeder) ---------------------------
# [INSTANCIA] Solo se leen al sembrar la instancia (db:seed --class=ClienteSeeder).
# No dejar ninguno vacío en producción: instancia:verificar lo revisa.
CLIENTE_RAZON_SOCIAL=
CLIENTE_NIT=
CLIENTE_SEDE=
# Código de prestador del REPS.
CLIENTE_CODIGO_PRESTADOR=
CLIENTE_ADMIN_EMAIL=
# Contraseña inicial del admin: larga y única. Cambiarla en el primer ingreso y
# borrarla de este archivo después de sembrar.
CLIENTE_ADMIN_PASSWORD=
CLIENTE_ADMIN_DOCUMENTO=

# --- Logs --------------------------------------------------------------------
# PROD: daily (un archivo por día en storage/logs, rotado según LOG_DAILY_DAYS)
LOG_CHANNEL=stack
LOG_STACK=single
# Días de log que se conservan con LOG_STACK=daily. Ajustar a la política de
# auditoría (D-04) cuando se defina.
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
# PROD: info. No subir a warning: la descarga de reportes PDF se registra con
# nivel info y es parte de la trazabilidad.
LOG_LEVEL=debug

# --- Base de datos -----------------------------------------------------------
# [INSTANCIA] Una base y un usuario por laboratorio, con privilegios solo sobre
# su base. Nunca apuntar las dos instancias a la misma base.
# Desarrollo: MySQL del servicio "db" de compose.yaml.
# PROD: DB_HOST=localhost y los datos creados en cPanel → MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dinamylab
DB_USERNAME=dinamylab
DB_PASSWORD=cambiar_esta_clave

# Solo Docker de desarrollo (no se usan en producción).
DB_ROOT_PASSWORD=cambiar_esta_clave_root
# Puerto expuesto en el host (para conectarse con DBeaver/Workbench).
FORWARD_DB_PORT=3307
APP_PORT=8000

# --- Sesión ------------------------------------------------------------------
SESSION_DRIVER=database
# Minutos de inactividad antes de cerrar la sesión.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Vacío = cookie solo para el dominio exacto. Nunca ".dominio.com": la cookie
# se compartiría entre los dos laboratorios.
SESSION_DOMAIN=
# [INSTANCIA] Debe llevar el nombre de la instancia.
SESSION_COOKIE=${APP_INSTANCE}_session
# PROD: true (la cookie solo viaja por HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Caché, colas y archivos -------------------------------------------------
# La caché y la cola viven en la base de cada instancia, así que no se cruzan.
# El prefijo es una segunda barrera si algún día se comparte un servidor de caché.
CACHE_STORE=database
CACHE_PREFIX=${APP_INSTANCE}_cache_
# Requiere el cron de queue:work en cPanel (runbook §1, paso 8).
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo (NT-02) ----------------------------------------------------------
# [COMPARTIDO] Las dos instancias pueden usar la misma cuenta SMTP; el límite de
# envíos por hora del hosting se comparte. Antes de enviar, configurar SPF, DKIM
# y DMARC del dominio remitente.
# PROD: smtp, con MAIL_SCHEME=smtps y MAIL_PORT=465 (o MAIL_SCHEME=smtp y 587).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# [INSTANCIA] Remitente y nombre visible de cada laboratorio.
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Sin uso hoy -------------------------------------------------------------
# Se conservan para cuando se migre a Redis o a almacenamiento S3 (versión
# multitenant / SaaS). No los necesita el despliegue en cPanel.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
