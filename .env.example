APP_NAME=Lissapp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Instancia (despliegue multi-cliente)
# APP_INSTANCE identifica este despliegue y debe coincidir con el nombre de la
# carpeta y con SESSION_COOKIE. Vacío = desarrollo/tests (la guarda no actúa).
APP_INSTANCE=
# Dominios que esta instancia puede atender, separados por comas.
APP_HOSTS=

# Datos del cliente que carga ClienteSeeder. No van en el código.
CLIENTE_RAZON_SOCIAL=
CLIENTE_NIT=
CLIENTE_SEDE=
CLIENTE_CODIGO_PRESTADOR=
CLIENTE_ADMIN_EMAIL=
CLIENTE_ADMIN_PASSWORD=
CLIENTE_ADMIN_DOCUMENTO=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL en Docker (servicio "db" del compose.yaml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dinamylab
DB_USERNAME=dinamylab
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_clave_root
# Puerto expuesto en el host (para conectarse con DBeaver/Workbench)
FORWARD_DB_PORT=3307
APP_PORT=8000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Debe llevar el nombre de la instancia para no compartir cookie entre clientes.
SESSION_COOKIE=${APP_INSTANCE}_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
